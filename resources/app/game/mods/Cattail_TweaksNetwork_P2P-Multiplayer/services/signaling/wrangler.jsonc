{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cattail-p2p-signaling-phase2",
  "main": "src/index.js",
  "compatibility_date": "2026-08-04",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "P2PRoom" },
      { "name": "ADMISSION", "class_name": "P2PAdmission" }
    ]
  },
  "exports": {
    "P2PRoom": { "type": "durable-object", "storage": "sqlite" },
    "P2PAdmission": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "ALLOWED_ORIGINS": "null,file://,http://127.0.0.1:8787",
    "ALLOW_MISSING_ORIGIN": "true",
    "ALLOW_INSECURE_LOCAL_INTERNAL_AUTH": "true",
    "SERVICE_DISABLED": "false",
    "ALPHA_INVITE_REQUIRED": "false",
    "ROOM_CREATIONS_PER_DAY": "20",
    "TURN_GRANTS_PER_DAY": "32",
    "TURN_DISABLED": "true",
    "TURN_TTL_SECONDS": "900",
    "TURN_REFRESH_AFTER_SECONDS": "600",
    "TURN_GRANTS_PER_ROOM_PER_DAY": "16"
  },
  "observability": {
    "enabled": false
  },
  "limits": {
    "cpu_ms": 10
  }
}
