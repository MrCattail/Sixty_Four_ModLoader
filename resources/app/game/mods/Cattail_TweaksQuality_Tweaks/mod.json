{
  "id": "Cattail_TweaksQuality_Tweaks",
  "uniqueId": "Cattail_TweaksQuality_Tweaks",
  "name": "Tweaks",
  "version": "0.1.0",
  "previousVersion": {
    "name": "Accessibility Pack",
    "version": "0.1.0"
  },
  "loaderVersion": ">=0.1.0",
  "entries": [
    "scripts/explainer-language-fix.js",
    "scripts/ending-skip.js",
    "scripts/accessibility-buttons.js",
    "scripts/stabilizer-surge-flash-reduction.js",
    "scripts/resource-glow-colors.js",
    "scripts/play-time-counter.js",
    "scripts/view-distance.js"
  ],
  "conflicts": [
    "Cattail_TweaksQuality_View-Distance",
    "Cattail_TweaksQuality_Ending-Skip",
    "Cattail_TweaksQuality_Accessibility-Buttons",
    "Cattail_Tweaks_Explainer-Language-Fix"
  ],
  "config": {
    "enableExplainerLanguageFix": {
      "type": "boolean",
      "label": "Explainer language fix",
      "default": true,
      "description": "Refresh pulsing explainer hints immediately after language changes."
    },
    "enableEndingSkip": {
      "type": "boolean",
      "label": "Ending skip",
      "default": true,
      "description": "Show a skip button during the pinhole ending and credits sequence."
    },
    "enableAccessibilityButtons": {
      "type": "boolean",
      "label": "Accessibility buttons",
      "default": true,
      "description": "Show the bottom accessibility control bar and reality-floor color palette."
    },
    "enableStabilizerSurgeFlashReduction": {
      "type": "boolean",
      "label": "Stabilizer surge flash reduction",
      "default": true,
      "description": "After the void altar exists, hide full-screen flashes caused by stabilizer-triggered surge effects.",
      "reloadPolicy": "hot"
    },
    "enableResourceGlowColors": {
      "type": "boolean",
      "label": "Resource glow colors",
      "default": true,
      "description": "Color resource icon glows by resource, with optional per-resource overrides.",
      "reloadPolicy": "hot"
    },
    "enablePlayTimeCounter": {
      "type": "boolean",
      "label": "Play time counter",
      "default": true,
      "description": "Show the active run play-time counter on the game canvas.",
      "reloadPolicy": "hot"
    },
    "playTimeCounterPosition": {
      "type": "string",
      "label": "Play time counter position",
      "default": "bottom-right",
      "description": "Use bottom-right to place it left of the shop button, or top-center to place it at the top center.",
      "reloadPolicy": "hot"
    },
    "resourceGlowColors": {
      "type": "resourceColors",
      "label": "Resource glow palette",
      "default": {},
      "description": "Per-resource glow color overrides. Empty rows use each resource's native color.",
      "reloadPolicy": "hot"
    },
    "enableViewDistance": {
      "type": "boolean",
      "label": "View distance limits",
      "default": true,
      "description": "Use expanded camera zoom limits."
    },
    "farthestZoom": {
      "type": "number",
      "label": "Farthest zoom",
      "default": 0.12,
      "min": 0.03,
      "max": 1,
      "step": 0.01,
      "description": "Lower values show more of the world. Vanilla far limit is 0.3."
    },
    "closestZoom": {
      "type": "number",
      "label": "Closest zoom",
      "default": 4,
      "min": 1,
      "max": 24,
      "step": 0.1,
      "description": "Higher values zoom closer to the world. Vanilla near limit is 2."
    },
    "fallbackZoom": {
      "type": "number",
      "label": "Fallback zoom",
      "default": 1,
      "min": 0.03,
      "max": 24,
      "step": 0.01,
      "description": "Used when the saved zoom value is missing or invalid."
    }
  },
  "description": "Combines view distance limits, ending skip, accessibility buttons, stabilizer surge flash reduction, resource glow colors, play-time counter, and dynamic explainer language refresh into one multi-entry quality mod.",
  "reloadOnConfigChange": true,
  "translations": {
    "sch": {
      "name": "便利调整",
      "description": "将视野距离限制、结局跳过、辅助按钮、稳定器浪涌闪烁削弱、资源光圈颜色、游戏时间计数器和动态提示语言刷新整合为一个综合调整 mod。",
      "config": {
        "enableExplainerLanguageFix": {
          "label": "提示语言修复",
          "description": "切换语言后立刻刷新会跳动的提示文本。"
        },
        "enableEndingSkip": {
          "label": "结局跳过",
          "description": "在针孔结局和制作人员名单阶段显示跳过按钮。"
        },
        "enableAccessibilityButtons": {
          "label": "辅助按钮",
          "description": "显示底部辅助控制栏和现实地板颜色调色板。"
        },
        "enableStabilizerSurgeFlashReduction": {
          "label": "稳定器浪涌闪烁削弱",
          "description": "虚空祭坛存在后，隐藏由稳定器触发浪涌效果造成的全屏闪烁。"
        },
        "enableResourceGlowColors": {
          "label": "资源光圈颜色",
          "description": "根据资源类型给资源图标光圈上色，并支持单独覆盖每种资源颜色。"
        },
        "enablePlayTimeCounter": {
          "label": "游戏时间计数器",
          "description": "在游戏画布上显示当前存档的游玩时间计数器。"
        },
        "playTimeCounterPosition": {
          "label": "游戏时间计数器位置",
          "description": "bottom-right 会放在商店按钮左侧，top-center 会放在顶部居中。"
        },
        "resourceGlowColors": {
          "label": "资源光圈调色板",
          "description": "逐资源设置光圈颜色。留空的资源会使用该资源的原生颜色。"
        },
        "enableViewDistance": {
          "label": "视野距离限制",
          "description": "使用扩展后的镜头缩放范围。"
        },
        "farthestZoom": {
          "label": "最远缩放",
          "description": "数值越低，可看到的世界范围越大。原版最远限制为 0.3。"
        },
        "closestZoom": {
          "label": "最近缩放",
          "description": "数值越高，镜头可以拉得越近。原版最近限制为 2。"
        },
        "fallbackZoom": {
          "label": "默认缩放",
          "description": "当保存的缩放值缺失或无效时使用。"
        }
      }
    },
