# Ignore the unpacked game by default. Track only the ModLoader workspace
# and the game files that the loader intentionally modifies.
*

!.gitignore
!README.md

!modloader-installer/
!modloader-installer/**

!resources/
!resources/app/
!resources/app/main.js
!resources/app/game/
!resources/app/game/index.html
!resources/app/game/scripts/
!resources/app/game/scripts/game.js
!resources/app/game/scripts/ui.js
!resources/app/game/scripts/sprites.js
!resources/app/game/modloader/
!resources/app/game/modloader/**
!resources/app/game/mods/
!resources/app/game/mods/**

dist/
node_modules/
*.log
npm-debug.log*
resources/app/game/modloader/backups/
resources/app/game/modloader/state/
resources/app/game/mods/*.zip
